# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma separated if multiple)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Enables AI Chat & Live Google Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Live Search Providers
# SERPAPI_API_KEY=your_serpapi_key_here
# GOOGLE_SEARCH_API_KEY=your_google_custom_search_key
# GOOGLE_SEARCH_ENGINE_ID=your_custom_search_cx_id

# Optional Direct Merchant APIs
# AMAZON_PAAPI_KEY=your_amazon_paapi_access_key
# AMAZON_PAAPI_SECRET=your_amazon_paapi_secret_key
# AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag-21
# CROMA_PARTNER_API_KEY=your_croma_partner_api_key
# NYKAA_PARTNER_API_KEY=your_nykaa_partner_api_key

# Payment Gateway (Future integration)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

